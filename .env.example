# Required: Telegram BotFather token. Never commit a real token.
BOT_TOKEN=replace_with_botfather_token

# Telegram numeric user IDs, comma/semicolon separated. Leave blank to disable admin access.
ADMIN_IDS=123456789

# Optional public HTTPS Telegram Mini App URL.
MINI_APP_URL=

# JSON storage path. On Render use /var/data/database.json after attaching a Persistent Disk.
DATABASE_PATH=database.json

# HomeProxy Hub API. Leave empty until the exact API contract is confirmed from your server.
HOME_PROXY_HUB_API_URL=
HOME_PROXY_HUB_API_TOKEN=
HOME_PROXY_AUTH_SCHEME=Bearer
HOME_PROXY_STATUS_PATH=
HOME_PROXY_CREDIT_PATH=
HOME_PROXY_ROUTE_PATH=
HOME_PROXY_TIMEOUT_SECONDS=15

# Render supplies PORT; for local use the default is 10000.
HOST=0.0.0.0
PORT=10000
LOG_LEVEL=INFO
